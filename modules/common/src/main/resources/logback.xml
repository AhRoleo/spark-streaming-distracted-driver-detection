<configuration>
  <!-- Affiche les logs dans la console avec un format horodaté -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- On ne garde que les messages WARN et ERROR pour ne pas polluer la console -->
  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
